{
  "name": "dsh-diff-review",
  "version": "0.3.22",
  "description": "Per-turn file-change diff review for DeepSeek Harness web: multi-workspace multi-baseline detection, per-session review dock, collapsible turn-tail panels, external editor diff (VS Code / VS2022), and standard settings integration.",
  "type": "module",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "diff",
    "review",
    "file-changes",
    "vscode",
    "vs2022"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "cordis.patch.yml",
    "lib",
    "src",
    "scripts",
    "README.md",
    "README_EN.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepublishOnly": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.6",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.7",
    "react": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
